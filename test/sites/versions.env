# Pinned versions for the wp-esc test sites. record.mjs passes this file to
# `docker compose --env-file` and to every seed script.
#
# Images are pinned by tag and by multi-arch index digest. Plugins are pinned
# to an exact WordPress.org release.
#
# Note: the plan named WordPress 6.x. WordPress 7.1 is the current release
# line, and the pinned Contact Form 7 line needs 7.1, so the sites run 7.1.4.

WPM_WP_IMAGE=wordpress:7.1.4-php8.3-apache@sha256:9001ea7dafd2bc3f05d068e6413b0edd2a116eeed4dfe9e08b6bd718dee4960a
WPM_CLI_IMAGE=wordpress:cli-2.12.0-php8.3@sha256:a4fff017eb08c03187e90fe52d4bff8d3a4d4a5103de05829a6e747c4ca3056e
WPM_DB_IMAGE=mariadb:11.4@sha256:d1891ede5a559f1086f55053bb8cc1569b0298338c4d72d71725a7f74f6ba620

WPM_YOAST_VERSION=28.8
WPM_SCF_VERSION=6.9.7
WPM_CF7_VERSION=6.2.4
WPM_FLAMINGO_VERSION=2.6.4
WPM_ELEMENTOR_VERSION=4.3.6

# EmDash Exporter (Task 9's import proof only; seed-emdash-exporter.sh). Not on
# WordPress.org: the release zip from github.com/emdash-cms/wp-emdash, checked by hash.
WPM_EXPORTER_VERSION=1.2.0
WPM_EXPORTER_SHA256=57fa5d5d249da8abf151f4d050c375c26498430ed4c9a6d65a39ea2d7e2585fc
